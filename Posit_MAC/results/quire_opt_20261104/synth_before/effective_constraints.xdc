####################################################################################
# Constraints from file : 'a35t_clock.xdc'
####################################################################################

# Shared synthesis/implementation clock contract, version A35T-C2 (clock values unchanged).
# Target part is fixed by syn/run_a35t.tcl: xc7a35tcpg236-1.
# No I/O arrival assumptions, false paths, or multicycle paths here.
create_clock -period 10.000 -name clk [get_ports clk]
set_clock_uncertainty -setup 0.100 [get_clocks clk]
set_clock_uncertainty -hold 0.100 [get_clocks clk]


####################################################################################
# Constraints from file : 'a35t_benchmark_100mhz.xdc'
####################################################################################

# A35T-C2: fixed historical I/O budget for every 10.000 ns benchmark.
# This is an assumed benchmark interface, NOT measured board timing.
# Clock and setup/hold uncertainty come from a35t_clock.xdc.
set_input_delay -clock clk -max 2.500 [get_ports -filter {DIRECTION == IN && NAME != clk}]
set_input_delay -clock clk -min 2.500 [get_ports -filter {DIRECTION == IN && NAME != clk}]
set_output_delay -clock clk -max 0.500 [get_ports -filter {DIRECTION == OUT}]
set_output_delay -clock clk -min 0.000 [get_ports -filter {DIRECTION == OUT}]


# Vivado Generated miscellaneous constraints 

#revert back to original instance
current_instance -quiet
